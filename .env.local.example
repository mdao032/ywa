# WordPress Headless API
NEXT_PUBLIC_WP_API_URL=https://ywaconsulting.com/wp-json/wp/v2

# Site URL (localhost en dev, domaine réel en prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — envoi des emails (formulaire contact + candidature)
# Créer un compte sur https://resend.com (gratuit jusqu'à 3 000 emails/mois)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email destinataire des formulaires de contact
CONTACT_EMAIL=contact@ywaconsulting.com

# Google Maps — carte page Contact
# Récupérer la clé depuis le site WP original (inspecteur réseau ou source HTML)
# Activer : Maps JavaScript API + Maps Embed API dans Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (optionnel — nécessaire pour les styles cloud et AdvancedMarker)
# Créer un Map ID dans Google Cloud Console > Google Maps Platform > Map management
NEXT_PUBLIC_GOOGLE_MAPS_ID=ywa-map
